pipeline {
    agent any

    // ─────────────────────────────────────────────
    // Pipeline-level environment variables
    // Secrets are stored as Jenkins Credentials and
    // injected here so they never appear in plain text.
    // ─────────────────────────────────────────────
    environment {
        // Application
        APP_NAME        = 'digital-heroes-api'
        APP_VERSION     = '0.0.1-SNAPSHOT'
        JAR_NAME        = "${APP_NAME}-${APP_VERSION}.jar"

        // Java / Maven
        JAVA_HOME       = tool name: 'JDK-17', type: 'jdk'   // Configure this tool in Jenkins → Global Tool Config
        MAVEN_HOME      = "${WORKSPACE}/apache-maven-3.9.6"
        MAVEN_OPTS      = '-Xmx1024m -XX:MaxMetaspaceSize=512m'

        // Docker
        DOCKER_REGISTRY = 'docker.io'                          // Change to your registry (e.g. ghcr.io, <account>.dkr.ecr.<region>.amazonaws.com)
        DOCKER_IMAGE    = "digitalheroes/${APP_NAME}"
        DOCKER_TAG      = "${BUILD_NUMBER}"                    // e.g. :42  — also tagged :latest below

        // Jenkins credential IDs (add these in Jenkins → Manage Credentials)
        DOCKER_CREDS    = credentials('dockerhub-credentials') // username/password credential
        DB_URL          = credentials('db-url')                // Secret text
        DB_USERNAME     = credentials('db-postgres')           // Secret text
        DB_PASSWORD     = credentials('db-root')           // Secret text
        STRIPE_KEY      = credentials('stripe-secret-key')     // Secret text
        STRIPE_WEBHOOK  = credentials('stripe-webhook-secret') // Secret text
    }

    // ─────────────────────────────────────────────
    // Global options
    // ─────────────────────────────────────────────
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))  // keep last 10 builds
        disableConcurrentBuilds()                        // prevent parallel runs on same branch
        timestamps()                                     // prefix every log line with timestamp
        timeout(time: 30, unit: 'MINUTES')               // fail-safe: abort if build hangs
    }

    // ─────────────────────────────────────────────
    // Trigger: poll SCM every 5 minutes, or use a
    // GitHub/GitLab webhook instead (recommended).
    // ─────────────────────────────────────────────
    triggers {
        pollSCM('H/5 * * * *')
    }

    // ─────────────────────────────────────────────
    // Pipeline stages
    // ─────────────────────────────────────────────
    stages {

        // ── 1. Checkout ──────────────────────────
        stage('Checkout') {
            steps {
                echo "==> Checking out source code on branch: ${env.GIT_BRANCH}"
                checkout scm
            }
        }

        // ── 2. Build ─────────────────────────────
        stage('Build') {
            steps {
                dir('backend') {
                    echo "==> Building Spring Boot application with Maven"
                    sh """
                        ${MAVEN_HOME}/bin/mvn clean package \
                            -DskipTests \
                            --batch-mode \
                            --no-transfer-progress \
                            -Dspring.datasource.url=jdbc:postgresql://localhost:5432/digitalheroes \
                            -Dspring.datasource.username=postgres \
                            -Dspring.datasource.password=root
                    """
                }
            }
            post {
                success {
                    echo "==> Build successful. JAR located at backend/target/"
                    archiveArtifacts artifacts: 'backend/target/*.jar', fingerprint: true
                }
            }
        }

        // ── 3. Unit & Integration Tests ───────────
        stage('Test') {
            steps {
                dir('backend') {
                    echo "==> Running tests"
                    sh """
                        ${MAVEN_HOME}/bin/mvn test \
                            --batch-mode \
                            --no-transfer-progress \
                            -Dspring.datasource.url=${DB_URL} \
                            -Dspring.datasource.username=${DB_USERNAME} \
                            -Dspring.datasource.password=${DB_PASSWORD} \
                            -Dstripe.secret-key=${STRIPE_KEY} \
                            -Dstripe.webhook.secret=${STRIPE_WEBHOOK}
                    """
                }
            }
            post {
                always {
                    // Publish JUnit test results
                    junit allowEmptyResults: true,
                          testResults: 'backend/target/surefire-reports/*.xml'
                }
                failure {
                    echo "==> Tests FAILED. Check the Test Results tab for details."
                }
            }
        }

        // ── 4. Docker Build ───────────────────────
        stage('Docker Build') {
            when {
                anyOf {
                    branch 'main'
                    branch 'master'
                    branch 'develop'
                }
            }
            steps {
                dir('backend') {
                    echo "==> Building Docker image: ${DOCKER_IMAGE}:${DOCKER_TAG}"
                    sh """
                        docker build \
                            --build-arg JAR_FILE=target/${APP_NAME}-*.jar \
                            -t ${DOCKER_IMAGE}:${DOCKER_TAG} \
                            -t ${DOCKER_IMAGE}:latest \
                            .
                    """
                }
            }
        }

        // ── 5. Docker Push ────────────────────────
        stage('Docker Push') {
            when {
                anyOf {
                    branch 'main'
                    branch 'master'
                    branch 'develop'
                }
            }
            steps {
                echo "==> Pushing Docker image to ${DOCKER_REGISTRY}"
                sh """
                    echo ${DOCKER_CREDS_PSW} | docker login ${DOCKER_REGISTRY} \
                        -u ${DOCKER_CREDS_USR} \
                        --password-stdin

                    docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                    docker push ${DOCKER_IMAGE}:latest
                """
            }
            post {
                always {
                    sh 'docker logout ${DOCKER_REGISTRY} || true'
                }
            }
        }

        // ── 6. Deploy (Production / Staging) ─────
        stage('Deploy') {
            when {
                branch 'main'   // only deploy from main
            }
            steps {
                echo "==> Deploying ${DOCKER_IMAGE}:${DOCKER_TAG} to production"

                // Example: SSH into server and re-pull + restart the container.
                // Replace with your actual deployment method (kubectl, docker-compose, etc.)
                sh """
                    docker stop ${APP_NAME} || true
                    docker rm   ${APP_NAME} || true

                    docker run -d \
                        --name ${APP_NAME} \
                        --restart unless-stopped \
                        -p 8080:8080 \
                        -e DATABASE_URL=${DB_URL} \
                        -e DATABASE_USERNAME=${DB_USERNAME} \
                        -e DATABASE_PASSWORD=${DB_PASSWORD} \
                        -e STRIPE_SECRET_KEY=${STRIPE_KEY} \
                        -e STRIPE_WEBHOOK_SECRET=${STRIPE_WEBHOOK} \
                        ${DOCKER_IMAGE}:${DOCKER_TAG}
                """
            }
        }

    } // end stages

    // ─────────────────────────────────────────────
    // Post-pipeline actions (run regardless of result)
    // ─────────────────────────────────────────────
    post {
        always {
            echo "==> Pipeline finished with status: ${currentBuild.currentResult}"

            // Clean up dangling Docker images to save disk space
            sh 'docker image prune -f || true'

            // Clean workspace (optional — comment out if you want to inspect files)
            cleanWs()
        }

        success {
            echo "==> BUILD SUCCEEDED ✔ — ${APP_NAME} v${DOCKER_TAG} is live."
            // Uncomment and configure to send Slack/email notifications:
            // slackSend channel: '#deployments',
            //           color: 'good',
            //           message: "✅ *${APP_NAME}* build #${BUILD_NUMBER} succeeded on `${env.GIT_BRANCH}`."
        }

        failure {
            echo "==> BUILD FAILED ✘ — check the console output."
            // emailext subject: "❌ Jenkins Build Failed: ${APP_NAME} #${BUILD_NUMBER}",
            //          body:    "Branch: ${env.GIT_BRANCH}\nCheck: ${env.BUILD_URL}",
            //          to:      'team@digitalheroes.com'
        }

        unstable {
            echo "==> BUILD UNSTABLE — some tests failed."
        }
    }
}
